:root {
  --bee-green: #30502c;
  --bee-gold: #d8a31a;
  --bee-light: #faf9f5;
}

body {
  background-color: var(--bee-light);
}

.navbar {
  background-color: var(--bee-green);
}

.navbar a {
  color: white !important;
}

h1, h2, h3 {
  color: var(--bee-green);
}

.quarto-title-banner {
  background-color: var(--bee-green);
}

.quarto-title-banner h1 {
  color: white;
}

/* Buttons */

.btn {
  display: inline-block;
  padding: 10px 18px;
  margin-right: 10px;
  margin-bottom: 10px;
  border-radius: 6px;
  text-decoration: none;
  color: white !important;
  font-weight: 600;
  transition: opacity 0.2s ease;
}

.btn:hover {
  opacity: 0.9;
}

.btn-primary {
  background-color: #0055A4; /* UVic blue */
}

.btn-success {
  background-color: #A6CE39; /* ORCID green */
}

.btn-info {
  background-color: #4285F4; /* Google blue */
}

.btn-secondary {
  background-color: #00CCBB; /* ResearchGate-style teal */
}