title: "Publications"
library(rorcid)
pubs <- as.data.frame(
works("0000-0001-9939-5417")
)
saveRDS(pubs, "publications.rds")
names(pubs)
grep("author", names(pubs), value = TRUE)
str(pubs$`external-ids.external-id`[[1]])
str(pubs[1, ])
install.packages(c("rcrossref", "purrr", "dplyr"))
library(rcrossref)
cr_works(dois = "10.4039/tce.2022.51")$data
library(rcrossref)
library(purrr)
library(dplyr)
pubs <- readRDS("publications.rds")
get_doi <- function(x) {
if(is.null(x)) return(NA_character_)
x$`external-id-value`[1]
}
pubs$doi <- map_chr(
pubs$`external-ids.external-id`,
get_doi
)
crossref_pubs <- map_df(
pubs$doi,
function(d){
if(is.na(d)) return(NULL)
tryCatch({
z <- cr_works(dois = d)$data
authors <- z$author[[1]]
author_string <- paste(
paste(authors$family, authors$given, sep = ", "),
collapse = "; "
)
data.frame(
year = z$issued,
title = z$title,
journal = z$container.title,
volume = z$volume,
doi = z$doi,
authors = author_string,
stringsAsFactors = FALSE
)
}, error = function(e) NULL)
}
)
saveRDS(crossref_pubs, "publications_full.rds")
